rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidWorkspace(data) {
      return data.workspaceId is string &&
             data.workspaceId.size() > 0 &&
             data.workspaceId.size() <= 128;
    }

    function isValidAuditLog(data) {
      return data.id is string &&
             data.timestamp is string &&
             data.action is string;
    }

    function isValidOgomojoloAttendance(data) {
      return (data.nisn is string || data.nisn is int || !('nisn' in data)) &&
             (data.namaSiswa is string || !('namaSiswa' in data));
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow get, list: if true;
      allow create, update: if isValidWorkspace(incoming());
      allow delete: if true;

      match /audit_logs/{logId} {
        allow get, list: if true;
        allow create, update: if isValidAuditLog(incoming());
        allow delete: if true;
      }
    }

    // Shared Ogomojolo Attendance integration collection
    match /rekap_absensi_ogomojolo/{recordId} {
      allow get, list: if true;
      allow create, update: if isValidOgomojoloAttendance(incoming());
      allow delete: if true;
    }
  }
}
